rule "Exclude required language mismatch"
salience 100
when
    $preferences : /preferences[ !requiredLanguages.empty ]
    $movie : /movies[ !hasAnyLanguage($preferences.requiredLanguages), !hasExclusionReason("required language") ]
then
    $movie.addExclusion("required language");
    traceEvents.add(new TraceEvent("EXCLUSION", drools.getRule().getName(), $movie.getId(), $movie.getTitle(), "Movie does not match a required language"));
    update($movie);
end

