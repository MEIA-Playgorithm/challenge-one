rule "Create recommendation"
salience -100
when
    $preferences : /preferences
    $movie : /movies[ !excluded, hasPreferenceReasons(), !recommended ]
then
    Recommendation recommendation = $movie.toRecommendation($preferences);
    recommendations.add(recommendation);
    traceEvents.add(new TraceEvent("RECOMMENDATION", drools.getRule().getName(), $movie.getId(), $movie.getTitle(), "Recommendation created with score " + recommendation.getScore()));
    $movie.markRecommended();
    update($movie);
end

query FindRecommendations
    $recommendation : /recommendations
end

query FindTraceEvents
    $traceEvent : /traceEvents
end
