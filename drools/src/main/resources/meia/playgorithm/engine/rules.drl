rule "Exclude audience age mismatch"
salience 100
when
    $preferences : /preferences
    $movie : /movies[ !isAgeAllowed($preferences.audienceAge), !hasExclusionReason("audience age") ]
then
    $movie.addExclusion("audience age");
    traceEvents.add(new TraceEvent("EXCLUSION", drools.getRule().getName(), $movie.getId(), $movie.getTitle(), "Movie is not suitable for the audience age"));
    update($movie);
end

rule "Exclude movies above mandatory duration"
salience 100
when
    $preferences : /preferences[ hasMaximumDuration() ]
    $movie : /movies[
        durationMinutes <= 0 || durationMinutes > $preferences.maximumDurationMinutes,
        !hasExclusionReason("duration limit")
    ]
then
    $movie.addExclusion("duration limit");
    traceEvents.add(new TraceEvent("EXCLUSION", drools.getRule().getName(), $movie.getId(), $movie.getTitle(), "Movie exceeds the maximum duration"));
    update($movie);
end

rule "Exclude movies before mandatory year"
salience 100
when
    $preferences : /preferences[ hasYearFrom() ]
    $movie : /movies[ year < $preferences.yearFrom, !hasExclusionReason("year from") ]
then
    $movie.addExclusion("year from");
    traceEvents.add(new TraceEvent("EXCLUSION", drools.getRule().getName(), $movie.getId(), $movie.getTitle(), "Movie is older than the requested period"));
    update($movie);
end

rule "Exclude movies after mandatory year"
salience 100
when
    $preferences : /preferences[ hasYearTo() ]
    $movie : /movies[ year > $preferences.yearTo, !hasExclusionReason("year to") ]
then
    $movie.addExclusion("year to");
    traceEvents.add(new TraceEvent("EXCLUSION", drools.getRule().getName(), $movie.getId(), $movie.getTitle(), "Movie is newer than the requested period"));
