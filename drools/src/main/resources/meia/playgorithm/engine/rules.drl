package meia.playgorithm.engine;

unit MovieRecommendationUnit;

import meia.playgorithm.model.Movie;
import meia.playgorithm.model.Recommendation;
import meia.playgorithm.model.TraceEvent;
import meia.playgorithm.model.UserPreferences;

rule "Exclude already watched movies"
salience 100
when
    $preferences : /preferences
    $movie : /movies[
        !$preferences.allowRewatch,
        $preferences.hasWatchedMovie(id),
        !hasExclusionReason("watched")
    ]
then
    $movie.addExclusion("watched");
    traceEvents.add(new TraceEvent("EXCLUSION", drools.getRule().getName(), $movie.getId(), $movie.getTitle(), "Movie already watched"));
    update($movie);
end

rule "Exclude explicitly disliked genres"
salience 100
when
    $preferences : /preferences
    $movie : /movies[ hasAnyGenre($preferences.dislikedGenres), !hasExclusionReason("disliked genre") ]
then
    $movie.addExclusion("disliked genre");
    traceEvents.add(new TraceEvent("EXCLUSION", drools.getRule().getName(), $movie.getId(), $movie.getTitle(), "Movie has an explicitly disliked genre"));
    update($movie);
end

