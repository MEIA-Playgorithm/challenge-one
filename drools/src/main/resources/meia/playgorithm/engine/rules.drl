rule "Exclude mandatory rating mismatch"
salience 100
when
    $preferences : /preferences[ ratingRequired, hasMinimumRating() ]
    $movie : /movies[ ratingImdb < $preferences.minimumRating, !hasExclusionReason("mandatory rating") ]
then
    $movie.addExclusion("mandatory rating");
    traceEvents.add(new TraceEvent("EXCLUSION", drools.getRule().getName(), $movie.getId(), $movie.getTitle(), "Movie rating is below a mandatory minimum"));
    update($movie);
end

rule "Exclude desirable rating outside tolerance"
salience 100
when
    $preferences : /preferences[ !ratingRequired, hasMinimumRating() ]
    $movie : /movies[
        ratingImdb < ($preferences.minimumRating - $preferences.ratingTolerance),
        !hasExclusionReason("rating outside tolerance")
    ]
then
    $movie.addExclusion("rating outside tolerance");
    traceEvents.add(new TraceEvent("EXCLUSION", drools.getRule().getName(), $movie.getId(), $movie.getTitle(), "Movie rating is outside the allowed tolerance"));
    update($movie);
end

rule "Preference reason: genre"
salience 50
when
    $preferences : /preferences
    $movie : /movies[ !excluded, hasAnyGenre($preferences.likedGenres), !hasPreferenceReason("genre") ]
then
    $movie.addPreferenceReason("genre", "preferred", 40);
    traceEvents.add(new TraceEvent("PREFERENCE", drools.getRule().getName(), $movie.getId(), $movie.getTitle(), "Preferred genre matched"));
    update($movie);
end

