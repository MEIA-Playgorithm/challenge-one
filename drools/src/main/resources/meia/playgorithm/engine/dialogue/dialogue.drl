// ---------------------------------------------------------------------------
// Queries used by DialogueService
// ---------------------------------------------------------------------------

query FindPendingQuestions
    $question : /questions
    not /answers[ key == $question.key ]
end

query FindDialogueAnswers
    $answer : /answers
end

query FindDialogueConclusions
    $conclusion : /conclusions
end
