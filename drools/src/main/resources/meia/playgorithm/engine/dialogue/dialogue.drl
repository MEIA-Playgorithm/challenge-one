package meia.playgorithm.engine.dialogue;

unit DialogueUnit;

import java.util.List;

// The experience dialogue: it finds out what the user feels like watching.
//
// Conclusion rules insert a DialogueConclusion. A rule that needs an answer
// from the user has an "Ask" rule: when the earlier conditions of that rule
// hold and the answer is missing, it inserts a DialogueQuestion, which
// DialogueService asks before firing the rules again. Questions stay in
// working memory, so they are never asked twice.
//
// The explanations read the conditions and the inserted conclusion of each
// rule straight from this file, so a rule only has to be written once.

// ---------------------------------------------------------------------------
// Experience choice
// ---------------------------------------------------------------------------

rule "Ask experiencia"
when
    $user : /users
    not /answers[ key == "experiencia" ]
    not /questions[ key == "experiencia" ]
then
    questions.add(DialogueQuestion.choice($user.getId(), "experiencia",
        "%s, que experiência te apetece ter com o filme de hoje?",
        List.of("emocao", "comedia", "acao", "misterio", "terror", "ficcao_cientifica", "fantasia"),
        "dialogo_experiencia"));
end

rule "dialogo_experiencia"
when
    $user : /users
    $experiencia : /answers[ key == "experiencia" ]
    not /conclusions[ type == "experiencia_sessao" ]
then
    conclusions.add(new DialogueConclusion($user.getId(), "experiencia_sessao", $experiencia.getValue(), drools.getRule().getName()));
end

// ---------------------------------------------------------------------------
// Emotional branch: each question depends on the previous affirmative answer
// ---------------------------------------------------------------------------

rule "Ask procura_historia_emocional"
when
    $user : /users
    /conclusions[ type == "experiencia_sessao", value == "emocao" ]
    not /answers[ key == "procura_historia_emocional" ]
    not /questions[ key == "procura_historia_emocional" ]
then
    questions.add(DialogueQuestion.yesNo($user.getId(), "procura_historia_emocional",
        "%s, apetece-te uma história que te emocione?", "dialogo_1"));
end

rule "dialogo_1"
when
    $user : /users
    /conclusions[ type == "experiencia_sessao", value == "emocao" ]
    /answers[ key == "procura_historia_emocional", affirmative ]
    not /conclusions[ type == "perfil_sessao", value == "emocional" ]
then
    conclusions.add(new DialogueConclusion($user.getId(), "perfil_sessao", "emocional", drools.getRule().getName()));
end

rule "Ask prefere_temas_realistas"
when
    $premise : /conclusions[ type == "perfil_sessao", value == "emocional" ]
    not /answers[ key == "prefere_temas_realistas" ]
    not /questions[ key == "prefere_temas_realistas" ]
then
    questions.add(DialogueQuestion.yesNo($premise.getUserId(), "prefere_temas_realistas",
        "%s, preferes uma história sobre situações da vida real?", "dialogo_2"));
end

rule "dialogo_2"
when
    $premise : /conclusions[ type == "perfil_sessao", value == "emocional" ]
    /answers[ key == "prefere_temas_realistas", affirmative ]
    not /conclusions[ type == "sugerir_genero", value == "Drama" ]
then
    conclusions.add(new DialogueConclusion($premise.getUserId(), "sugerir_genero", "Drama", drools.getRule().getName()));
end

rule "Ask aceita_final_triste"
when
    $premise : /conclusions[ type == "sugerir_genero", value == "Drama" ]
    not /answers[ key == "aceita_final_triste" ]
    not /questions[ key == "aceita_final_triste" ]
then
    questions.add(DialogueQuestion.yesNo($premise.getUserId(), "aceita_final_triste",
        "%s, estás disposto a ver um filme com um final triste?", "dialogo_3"));
end

rule "dialogo_3"
when
    $premise : /conclusions[ type == "sugerir_genero", value == "Drama" ]
    /answers[ key == "aceita_final_triste", affirmative ]
    not /conclusions[ type == "sugerir_tom", value == "triste" ]
then
    conclusions.add(new DialogueConclusion($premise.getUserId(), "sugerir_tom", "triste", drools.getRule().getName()));
end

